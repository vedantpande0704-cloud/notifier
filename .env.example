# ==============================================================================
# OpenNotify Production Configuration Environment Template
# ==============================================================================

# Server & Network
PORT=3000
NODE_ENV=production
API_BASE_URL=http://localhost:3000

# Security & Token Cryptography
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_chars
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# ------------------------------------------------------------------------------
# Database Provider Configuration (Options: 'sqlite', 'supabase')
# ------------------------------------------------------------------------------
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=./data/opennotify.db

# Supabase PostgreSQL Configuration (Used when DATABASE_TYPE=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# WhatsApp Gateway Configuration (Options: 'dev', 'meta', 'twilio')
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=dev

# Meta WhatsApp Cloud API (Graph API v18.0)
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_access_token
META_WA_VERIFY_TOKEN=opennotify_meta_webhook_secret

# ------------------------------------------------------------------------------
# Email Gateway Configuration (Options: 'dev', 'smtp', 'resend')
# ------------------------------------------------------------------------------
MAIL_PROVIDER=dev
EMAIL_FROM="OpenNotify <auth@yourdomain.com>"

# SMTP Gateway (Gmail, AWS SES, Brevo, Postmark)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password

# Resend API Key
RESEND_API_KEY=re_your_api_key

# ------------------------------------------------------------------------------
# SMS Gateway Configuration (Options: 'dev', 'twilio')
# ------------------------------------------------------------------------------
SMS_PROVIDER=dev
SMS_FROM_NUMBER=+18005550199
SMS_SENDER_NAME=OpenNotify

# Twilio SMS REST API
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
